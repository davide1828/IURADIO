# Android Studio / Gradle .gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/DALVIK VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by the build process
proguard/

# Log files
*.log

# Android Studio navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio project files
.idea/
*.iml
*.iws
*.ipr

# Keystore files
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# Memory dumps
*.hprof

# OS generated files
.DS_Store
Thumbs.db
